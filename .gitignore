node_modules/
.expo/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Python / backend
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
backend/media/
*.db

# Generated by `expo prebuild` — 120+ MB, regenerable, never committed.
mobile-app/android/
mobile-app/ios/

# App signing key and its password. Losing these means the app can never be
# updated under the same identity; committing them means anyone can sign as you.
mobile-app/credentials.json
mobile-app/credentials/
*.keystore
*.jks

# Firebase config, per deployment. Not a secret, but not shared across installs.
mobile-app/google-services.json
mobile-app/GoogleService-Info.plist
backend/firebase-credentials.json

# Firebase service-account keys. These carry a private key that can send push
# to every user and read the project's data — never in a repo, public or not.
backend/secrets/
backend/firebase-credentials.json
*firebase-adminsdk*.json

# Local release signing config — holds the key password.
mobile-app/android/keystore.properties
