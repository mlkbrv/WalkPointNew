{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "stride-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "mobile-app"
      ],
      "port": 3000
    },
    {
      "name": "stride-admin",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "admin-panel"
      ],
      "port": 5173
    },
    {
      "name": "policy-static",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "mobile-app/privacy"
      ],
      "port": 4173
    }
  ]
}
