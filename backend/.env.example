# --- App ---
APP_NAME=STRIDE API
ENVIRONMENT=local
DEBUG=true
API_V1_PREFIX=/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=stride
POSTGRES_USER=stride
POSTGRES_PASSWORD=change-me

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=30

# --- SMS (provider plugged in later) ---
SMS_BACKEND=mock          # mock | twilio
SMS_CODE_TTL_MINUTES=5
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Firebase Cloud Messaging ---
# The service-account JSON goes in backend/secrets/ (gitignored — it holds a
# private key that can push to every user). Compose mounts that directory
# read-only at /app/secrets, so the path below is the in-container one.
FCM_ENABLED=false
FIREBASE_CREDENTIALS_FILE=/app/secrets/firebase-admin.json

# --- Media storage ---
STORAGE_BACKEND=local     # local | s3
MEDIA_ROOT=./media
MEDIA_URL_PREFIX=/media

# --- First-boot bootstrap ---
# Creates this superadmin on start if the account does not exist. Managed free
# tiers give you no shell, so this is the only way in on a fresh deploy.
# An existing account is never touched — a redeploy will not reset the password.
# Clear both once you are in, or change the password from the panel.
BOOTSTRAP_SUPERADMIN_EMAIL=admin@example.com
# At least 12 characters, or bootstrap refuses to create the account.
BOOTSTRAP_SUPERADMIN_PASSWORD=

# --- Scheduled jobs over HTTP ---
# Set this to enable POST /v1/jobs/*/run for an external cron. Empty = the
# endpoints answer 404. Only needed where you cannot run the `worker` service.
CRON_SECRET=

# --- Scheduler ---
SCHEDULER_ENABLED=true
DAILY_ROLLUP_HOUR=23
DAILY_ROLLUP_MINUTE=59
SERVER_TIMEZONE=Asia/Baku
